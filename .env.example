# Endereço da API do CRM (sem barra no fim). Em produção: https://crm.seudominio.com.br/api
CRM_API_URL=http://localhost:4100/api
# Chave de integração criada em CRM → Configurações → Integrações (escopos sales:read + sales:write).
# Fica só no servidor do dashboard; nunca vai para o navegador.
CRM_API_KEY=crm_00000000_troque-esta-chave
# Segredo para assinar o cookie de sessão (32+ caracteres aleatórios).
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Porta do servidor do dashboard.
PORT=4000
# Validade dos dados em cache, em segundos (30–60).
CACHE_TTL_SECONDS=45
# Cookie só por HTTPS (true em produção).
COOKIE_SECURE=false
# Endereço público do CRM, para os links "ver no CRM".
CRM_WEB_URL=http://localhost:5173
# Chave Pix e nome usados na mensagem de cobrança do WhatsApp.
CLINIC_PIX_KEY=
CLINIC_NAME=Studios Aryana
# Arquivo onde ficam as metas mensais configuradas no dashboard.
GOALS_FILE=data/goals.json
